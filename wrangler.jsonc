{
  // Static site on Cloudflare Workers static assets (free: static asset requests are free and unlimited).
  // No Worker script: every request is served from the assets directory.
  "name": "xerolas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./.cf-dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
